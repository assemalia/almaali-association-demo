# ============================================================
#  متغيّرات البيئة — قالب (.env.example)
#  انسخ هذا الملف إلى .env ثم املأ القيم:  cp .env.example .env
#  ملف .env الحقيقي مُستبعَد من git (انظر .gitignore) ولا يُرفع أبدًا.
# ============================================================

# رابط مشروع Supabase.
#  - للنسخة التجريبية المحلية (Docker): http://127.0.0.1:54321
#  - للمشروع السحابي: https://<YOUR_PROJECT_REF>.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321

# المفتاح العام (anon / publishable) — آمن أن يكون ظاهرًا في الواجهة،
# فالحماية الحقيقية تأتي من سياسات RLS على مستوى قاعدة البيانات.
# تحصل عليه من مخرجات "supabase start" (محليًا) أو من Project Settings → API (سحابيًا).
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# معرّف المشروع (اختياري، تستعمله بعض الأدوات).
#  - محليًا: اترك القيمة الافتراضية أدناه.
#  - سحابيًا: ضع YOUR_PROJECT_REF.
VITE_SUPABASE_PROJECT_ID=almaali-demo
